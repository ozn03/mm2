    local myRole = MM2.getMyRole()
    if myRole ~= "murderer" then return end

    local target = getClosestEnemy(Settings.KnifeAura_Range)
    if not target or not target.Character then return end
    local lchar = LocalPlayer.Character
    if not lchar then return end

    -- Bıçağı tool üzerinden simulate et
    local tool = lchar:FindFirstChildWhichIsA("Tool")
    if not tool then return end

    -- Knife remote bul ve tetikle
    local hr = tool:FindFirstChild("Handle")
    if not hr then return end

    -- TouchInterest / Touched ile zarara neden ol (basit yöntem)
    local targetHum = target.Character:FindFirstChild("Humanoid")
    if targetHum and targetHum.Health > 0 then
        -- Sadece yakın mesafedeyse — server-side hasar için remote gerekli
        -- Bu kısım executor'ın hookfunction desteğine bağlı
