-- MM2'de bıçak RemoteEvent ile fırlatılır.
-- Hedef pozisyonu yakın oyuncuya yönlendiriyoruz.
local function hookKnifeThrow()
    local ns = game:GetService("NetworkClient") -- placeholder
    -- MM2'nin bıçak remote'u "SEvent" veya "RemoteEvent" adında
    local rs = Workspace:FindFirstChild("GameFolder")
    if not rs then rs = Workspace end

    -- Tüm RemoteEvent'leri dinle, bıçak fırlatma olanı yakala
    local function checkRemote(remote)
        if not remote:IsA("RemoteEvent") then return end
        local n = remote.Name:lower()
        if n:find("throw") or n:find("knife") or n:find("fling") then
            local oldFire = remote.FireServer
            -- FireServer hook (executor destekliyorsa)
            if hookfunction then
                hookfunction(oldFire, function(self, ...)
                    if Settings.SilentAim_Knife then
                        local target = getClosestPlayerOnScreen(Settings.SilentAim_FOV)
                        if target then
                            local args = {...}
                            -- Genellikle 1. argüman hedef pozisyon / CFrame
                            args[1] = CFrame.new(target.Position)
                            return oldFire(self, table.unpack(args))
                        end
                    end
                    return oldFire(self, ...)
                end)
            end
        end
    end

    for _, v in ipairs(Workspace:GetDescendants()) do checkRemote(v) end
    Workspace.DescendantAdded:Connect(checkRemote)
    for _, v in ipairs(game:GetDescendants()) do checkRemote(v) end
    game.DescendantAdded:Connect(checkRemote)
end
pcall(hookKnifeThrow)

