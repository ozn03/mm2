    descLbl.Size               = UDim2.new(1, -70, 0, 18)
    descLbl.Position           = UDim2.new(0, 12, 0, 28)
    descLbl.BackgroundTransparency = 1
    descLbl.Text               = description
    descLbl.TextColor3         = Color3.fromRGB(110, 110, 120)
    descLbl.Font               = Enum.Font.SourceSans
    descLbl.TextSize           = 11
    descLbl.TextXAlignment     = Enum.TextXAlignment.Left

    -- Toggle switch
    local switchBg = Instance.new("TextButton", row)
    switchBg.Size             = UDim2.new(0, 46, 0, 24)
    switchBg.Position         = UDim2.new(1, -54, 0.5, -12)
    switchBg.BackgroundColor3 = Settings[settingKey] and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(50, 50, 55)
    switchBg.Text             = ""
    Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", switchBg)
    knob.Size             = UDim2.new(0, 18, 0, 18)
    knob.Position         = Settings[settingKey]
        and UDim2.new(1, -21, 0.5, -9)
        or  UDim2.new(0, 3, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad)

    switchBg.MouseButton1Click:Connect(function()
        if settingKey then Settings[settingKey] = not Settings[settingKey] end
        local isOn = settingKey and Settings[settingKey] or false
        if callback then isOn = callback(isOn) end

        local onColor  = Color3.fromRGB(255, 60, 60)
        local offColor = Color3.fromRGB(50, 50, 55)
        TweenService:Create(switchBg, tweenInfo, { BackgroundColor3 = isOn and onColor or offColor }):Play()
        TweenService:Create(iconFrame, tweenInfo, { BackgroundColor3 = isOn and onColor or offColor }):Play()
        TweenService:Create(knob, tweenInfo, {
            Position = isOn and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        }):Play()
    end)
end

-- Slider
local function addSlider(tabIdx, label, minVal, maxVal, defaultVal, settingKey)
    local row = Instance.new("Frame", tabPages[tabIdx])
    row.Size             = UDim2.new(0, 260, 0, 56)
    row.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
    row.LayoutOrder      = nextOrder(tabIdx)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
    local rowStroke = Instance.new("UIStroke", row)
    rowStroke.Color = Color3.fromRGB(40, 40, 45); rowStroke.Thickness = 1

    local valText = Instance.new("TextLabel", row)
    valText.Size               = UDim2.new(1, -12, 0, 22)
    valText.Position           = UDim2.new(0, 12, 0, 4)
    valText.BackgroundTransparency = 1
    valText.Text               = label .. ":  " .. tostring(defaultVal)
    valText.TextColor3         = Color3.fromRGB(200, 200, 200)
    valText.Font               = Enum.Font.SourceSansBold
    valText.TextSize           = 12
    valText.TextXAlignment     = Enum.TextXAlignment.Left

    local track = Instance.new("Frame", row)
    track.Size             = UDim2.new(1, -24, 0, 6)
    track.Position         = UDim2.new(0, 12, 0, 34)
    track.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local pct0 = (defaultVal - minVal) / (maxVal - minVal)

    local fill = Instance.new("Frame", track)
    fill.Size             = UDim2.new(pct0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("TextButton", track)
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = UDim2.new(pct0, -7, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.Text             = ""
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local sliding = false
    knob.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then sliding = true end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not sliding then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement
        and i.UserInputType ~= Enum.UserInputType.Touch then return end
        local tw   = math.max(track.AbsoluteSize.X, 1)
        local pct  = math.clamp((i.Position.X - track.AbsolutePosition.X) / tw, 0, 1)
        local val  = math.round(minVal + pct * (maxVal - minVal))
        fill.Size  = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, -7, 0.5, -7)
        valText.Text  = label .. ":  " .. tostring(val)
        if settingKey then Settings[settingKey] = val end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then sliding = false end
    end)
end

