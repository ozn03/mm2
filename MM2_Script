-- En yakın oyuncuyu 3D mesafeye göre bul (Katil bıçak için)
local function getNearestPlayerHead()
    local lchar = LocalPlayer.Character
    local lhrp  = lchar and lchar:FindFirstChild("HumanoidRootPart")
    if not lhrp then return nil end
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hrp  = p.Character:FindFirstChild("HumanoidRootPart")
            local hum  = p.Character:FindFirstChild("Humanoid")
            if head and hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - lhrp.Position).Magnitude
                if d < closestDist then
                    closest     = head
                    closestDist = d
                end
            end
        end
    end
    return closest
end

-- Katili bul ve headini döndür (Şerif için — FOV yok, direkt katil)
local function getMurdererHead()
    local roles = MM2.getRoles()
    local murderer = roles.Murderer
    if not murderer or not murderer.Character then return nil end
    local head = murderer.Character:FindFirstChild("Head")
    local hum  = murderer.Character:FindFirstChild("Humanoid")
    if not head or not hum or hum.Health <= 0 then return nil end
    return head
end

local function getClosestEnemy(range)
    local lchar = LocalPlayer.Character
    local lhrp  = lchar and lchar:FindFirstChild("HumanoidRootPart")
    if not lhrp then return nil end
    local closest, closestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - lhrp.Position).Magnitude
                if d < range and d < closestDist then
                    closest     = p
                    closestDist = d
                end
            end
        end
    end
    return closest
end

-- ================================================================
-- SILENT AIM (Tabanca — Şerif)
-- ================================================================
local function setupSilentAimGun()
    -- FireBullet veya mouse.Hit yönlendirme yöntemi
    local mt = getrawmetatable and getrawmetatable(game)
    if not mt then return end
    local old_ni = mt.__index
    setreadonly(mt, false)
    mt.__newindex = mt.__newindex -- korunuyor
    -- Raycast yönlendirmesi için mouse.Hit hook
    local oldHit
    if hookmetamethod then
        oldHit = hookmetamethod(game, "__index", function(self, key)
            if not checkcaller() and key == "Hit" and tostring(self):find("Mouse") then
                -- Şerif: ateş edince direkt katile gider, FOV yok
                if Settings.SilentAim_Sheriff then
                    local target = getMurdererHead()
                    if target then
                        return CFrame.new(target.Position)
                    end
                end
                -- Katil: bıçak fırlatınca direkt en yakın kişiye gider, FOV yok
                if Settings.SilentAim_Knife then
                    local target = getNearestPlayerHead()
                    if target then
                        return CFrame.new(target.Position)
                    end
                end
            end
            return oldHit(self, key)
        end)
    end
    setreadonly(mt, true)
end
pcall(setupSilentAimGun)

