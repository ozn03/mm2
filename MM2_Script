local espObjects = {}

local function getRoleColor(player)
    local tool = player.Character and player.Character:FindFirstChildWhichIsA("Tool")
    if not tool then return Settings.ESP_Colors.Innocent end
    local n = tool.Name:lower()
    if n:find("knife") or n:find("blade") or n:find("murd") then
        return Settings.ESP_Colors.Murderer
    elseif n:find("gun") or n:find("sheriff") or n:find("revolver") then
        return Settings.ESP_Colors.Sheriff
    end
    return Settings.ESP_Colors.Innocent
end

local function getRoleLabel(player)
    local tool = player.Character and player.Character:FindFirstChildWhichIsA("Tool")
    if not tool then return "[Masum]" end
    local n = tool.Name:lower()
    if n:find("knife") or n:find("blade") or n:find("murd") then return "[KATİL🔪]"
    elseif n:find("gun") or n:find("sheriff") or n:find("revolver") then return "[ŞERİF🔫]"
    end
    return "[Masum]"
end

local function createESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end

    local function setup(char)
        task.wait(0.5)
        local head = char:WaitForChild("Head", 10)
        local hrp  = char:WaitForChild("HumanoidRootPart", 10)
        if not head or not hrp then return end

        -- Eski temizle
        if head:FindFirstChild("MM2ESP") then head.MM2ESP:Destroy() end

        -- BillboardGui
        local bbg = Instance.new("BillboardGui")
        bbg.Name        = "MM2ESP"
        bbg.AlwaysOnTop = true
        bbg.Size        = UDim2.new(0, 220, 0, 70)
        bbg.StudsOffset = Vector3.new(0, 3.2, 0)
        bbg.Parent      = head

        -- İsim + Rol
        local nameLabel = Instance.new("TextLabel", bbg)
        nameLabel.Name                   = "NameLabel"
        nameLabel.Size                   = UDim2.new(1, 0, 0.5, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text                   = player.Name .. " " .. getRoleLabel(player)
        nameLabel.TextColor3             = getRoleColor(player)
        nameLabel.TextStrokeTransparency = 0
        nameLabel.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
        nameLabel.Font                   = Enum.Font.SourceSansBold
        nameLabel.TextSize               = 14

        -- Can + Mesafe
        local infoLabel = Instance.new("TextLabel", bbg)
        infoLabel.Name                   = "InfoLabel"
        infoLabel.Size                   = UDim2.new(1, 0, 0.5, 0)
        infoLabel.Position               = UDim2.new(0, 0, 0.5, 0)
        infoLabel.BackgroundTransparency = 1
        infoLabel.TextColor3             = Color3.fromRGB(200, 200, 200)
        infoLabel.TextStrokeTransparency = 0
        infoLabel.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
        infoLabel.Font                   = Enum.Font.SourceSans
        infoLabel.TextSize               = 12

        -- Kutu ESP
        local boxBbg = Instance.new("BillboardGui", hrp)
        boxBbg.Name        = "MM2BoxESP"
        boxBbg.AlwaysOnTop = true
        boxBbg.Size        = UDim2.new(4.2, 0, 6, 0)
        boxBbg.Adornee     = hrp

        local boxFrame = Instance.new("Frame", boxBbg)
        boxFrame.Size                  = UDim2.new(1, 0, 1, 0)
        boxFrame.BackgroundTransparency = 1

        local boxStroke = Instance.new("UIStroke", boxFrame)
        boxStroke.Thickness = 1.5
        boxStroke.Color     = getRoleColor(player)

        -- Tracer (ekran altından oyuncuya çizgi) — Line3D olmadan basit
        -- BillboardGui + frame ile simüle edilir
        local tracerBbg = Instance.new("BillboardGui", hrp)
        tracerBbg.Name        = "MM2Tracer"
        tracerBbg.AlwaysOnTop = true
        tracerBbg.Size        = UDim2.new(0, 2, 0, 2)
        tracerBbg.Adornee     = hrp

        espObjects[player] = {
            bbg       = bbg,
            boxBbg    = boxBbg,
            tracerBbg = tracerBbg,
            nameLabel = nameLabel,
            infoLabel = infoLabel,
            boxStroke = boxStroke,
        }
    end

    player.CharacterAdded:Connect(setup)
    if player.Character then setup(player.Character) end
end

local function removeESP(player)
    if espObjects[player] then
        for _, v in pairs(espObjects[player]) do
            pcall(function() v:Destroy() end)
        end
        espObjects[player] = nil
    end
    if player.Character then
        local head = player.Character:FindFirstChild("Head")
        local hrp  = player.Character:FindFirstChild("HumanoidRootPart")
        if head then
            if head:FindFirstChild("MM2ESP") then head.MM2ESP:Destroy() end
        end
        if hrp then
            if hrp:FindFirstChild("MM2BoxESP") then hrp.MM2BoxESP:Destroy() end
            if hrp:FindFirstChild("MM2Tracer") then hrp.MM2Tracer:Destroy() end
        end
    end
end

-- ESP Güncelleme Döngüsü
RunService.RenderStepped:Connect(function()
    if not Settings.ESP_Enabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if espObjects[p] then
                for _, v in pairs(espObjects[p]) do
                    pcall(function() v.Enabled = false end)
                end
                if espObjects[p].bbg then
                    pcall(function() espObjects[p].bbg.Enabled = false end)
                end
                if espObjects[p].boxBbg then
                    pcall(function() espObjects[p].boxBbg.Enabled = false end)
                end
            end
        end
        return
    end

    local lchar = LocalPlayer.Character
    local lhrp  = lchar and lchar:FindFirstChild("HumanoidRootPart")

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not espObjects[p] then createESP(p) end
            local obj = espObjects[p]
            if not obj then continue end

            local color = getRoleColor(p)
            local roleTag = getRoleLabel(p)
            local hum = p.Character:FindFirstChild("Humanoid")
            local hp  = hum and math.round(hum.Health) or 0
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local dist = 0
            if lhrp and hrp then
                dist = math.round((hrp.Position - lhrp.Position).Magnitude)
            end

            if obj.bbg then
                obj.bbg.Enabled = true
                if obj.nameLabel then
                    obj.nameLabel.Visible  = Settings.ESP_Names
                    obj.nameLabel.Text     = p.Name .. " " .. roleTag
                    obj.nameLabel.TextColor3 = color
                end
                if obj.infoLabel then
                    local info = ""
                    if Settings.ESP_Health   then info = info .. "❤ " .. hp .. "  " end
                    if Settings.ESP_Distance then info = info .. "📍 " .. dist .. "m" end
                    obj.infoLabel.Text    = info
                    obj.infoLabel.Visible = (Settings.ESP_Health or Settings.ESP_Distance)
                end
            end
            if obj.boxBbg then
                obj.boxBbg.Enabled = Settings.ESP_Box
                if obj.boxStroke then obj.boxStroke.Color = color end
            end
            if obj.tracerBbg then
                obj.tracerBbg.Enabled = Settings.ESP_Tracers
            end
        end
    end
end)

-- ESP oyuncu temizleme
for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

