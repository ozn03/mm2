local function addTeleportBtn(tabIdx, label, actionFn)
    local btn = Instance.new("TextButton", tabPages[tabIdx])
    btn.Size             = UDim2.new(0, 260, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
    btn.Text             = "  " .. label
    btn.TextColor3       = Color3.fromRGB(200, 200, 200)
    btn.Font             = Enum.Font.SourceSansBold
    btn.TextSize         = 13
    btn.TextXAlignment   = Enum.TextXAlignment.Left
    btn.LayoutOrder      = nextOrder(tabIdx)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", btn)
    s.Color = Color3.fromRGB(45, 45, 50); s.Thickness = 1

    btn.MouseButton1Click:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {
            BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        }):Play()
        task.delay(0.2, function()
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(28, 28, 32)
            }):Play()
        end)
        pcall(actionFn)
    end)
end

