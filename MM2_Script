local MM2 = {
    getRoles = function()
        -- MM2'nin RemoteFunction veya değerleri üzerinden rol bilgisi
        local result = { Murderer = nil, Sheriff = nil }
        local ok, remote = pcall(function()
            return Workspace:WaitForChild("GameFolder", 3)
        end)
        if ok and remote then
            -- Olası rol klasörlerini tara
        end
        -- Alternatif: tool ismine / tag'e göre
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local tool = p.Character:FindFirstChildWhichIsA("Tool")
                if tool then
                    local n = tool.Name:lower()
                    if n:find("knife") or n:find("blade") or n:find("murd") then
                        result.Murderer = p
                    elseif n:find("gun") or n:find("sheriff") or n:find("revolver") then
                        result.Sheriff = p
                    end
                end
            end
        end
        return result
    end,
    getMyRole = function()
        local lchar = LocalPlayer.Character
        if not lchar then return "innocent" end
        local tool = lchar:FindFirstChildWhichIsA("Tool")
        if not tool then return "innocent" end
        local n = tool.Name:lower()
        if n:find("knife") or n:find("blade") or n:find("murd") then return "murderer"
        elseif n:find("gun") or n:find("sheriff") or n:find("revolver") then return "sheriff"
        end
        return "innocent"
    end,
}

